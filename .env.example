# PostgreSQL connection used by Prisma and the CMS.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tirthvaani?schema=public"
NEXT_PUBLIC_SITE_URL="https://tirthvaani.com"
CMS_CRON_SECRET="replace-with-a-long-random-secret-for-scheduled-publication"

# First administrator. Used only when running `npm run db:seed`.
ADMIN_BOOTSTRAP_NAME="Site Administrator"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-unique-password-of-14-characters-or-more"

# Optional S3-compatible media storage. Media uploads remain disabled until configured.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
